# Copy this file to .env. Never commit your real .env.
HOST=127.0.0.1
DATA_DIR=./data
PORT_UPLOAD=3101
PORT_BEST=3102
PORT_WORST=3103
PORT_REPORT=3104

# Generate TWO distinct keys: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=
OWNER_API_KEY=

# Use the API key and HTTPS endpoint from your Alibaba Cloud Model Studio workspace.
# See https://help.aliyun.com/en/model-studio/qwen-api-via-openai-chat-completions
DASHSCOPE_API_KEY=your-alibaba-cloud-model-studio-api-key
DASHSCOPE_BASE_URL=
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_TEXT_MODEL=qwen-plus

UPLOADS_PER_DAY=20
RECOMMENDATIONS_PER_DAY=200
AGENT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_AI=4
